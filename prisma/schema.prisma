// Coterie v1 — database schema.
// Source of truth: coterie-v1-schema-spec.md (spec §3). Read the spec before
// changing anything here. Deviations from the spec's literal column lists are
// noted inline with a rationale.
//
// Conventions (spec §3): all PKs are uuid; every tenant table carries org_id
// (uuid NOT NULL, FK -> organizations) and gets an RLS policy (added in a
// later migration, build-order item 3); all tables carry created_at/updated_at.
// DB identifiers are snake_case (RLS SQL references them); the Prisma client
// surface is camelCase via @map/@@map.
//
// Status/type fields are `text` (String) by ratified decision — "status is a
// field, not separate tables" (spec §2, decision #2). Allowed values are
// documented in comments; validate at boundaries, not via Postgres enums
// (deliberately avoided so lifecycle vocabularies can evolve additively).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform-level identity (NOT tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────────

/// The tenant. One row per client org (spec §3.1). Not itself tenant-scoped.
model Organization {
  id       String  @id @default(uuid()) @db.Uuid
  /// Clerk organization id (org_…) — the bridge from a signed-in session's
  /// active org to our tenant uuid (fed into app.org_id / withOrg). Mirrors
  /// users.clerk_id. Nullable + unique: seeded test tenants and the HVEDC data
  /// migration have no Clerk org, and Postgres unique permits multiple NULLs.
  clerkId  String? @unique @map("clerk_id")
  name     String
  /// Label only in v1: edc, chamber, council, ria (no workflow branching yet).
  orgType  String  @map("org_type")
  /// Feature flags, sync windows, branding.
  settings Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships            OrgMembership[]
  companies              Company[]
  contacts               Contact[]
  projects               Project[]
  projectLinks           ProjectLink[]
  introductions          Introduction[]
  meetings               Meeting[]
  meetingAttendees       MeetingAttendee[]
  meetingStaffAttendees  MeetingStaffAttendee[]
  actionItems            ActionItem[]
  invoices               Invoice[]
  payments               Payment[]
  newsItems              NewsItem[]
  emailMessages          EmailMessage[]
  activities             Activity[]
  integrationCredentials IntegrationCredential[]
  events                 Event[]
  eventInvitees          EventInvitee[]
  eventConversions       EventConversion[]
  membershipProposals    MembershipProposal[]
  valueDelivered         ValueDelivered[]
  affiliations           Affiliation[]
  keyRelationships       KeyRelationship[]
  projectTeamMembers     ProjectTeamMember[]
  fundingSources         FundingSource[]
  introDismissals        IntroDismissal[]
  prospectDismissals     ProspectDismissal[]
  unmatchedAttendees     UnmatchedAttendee[]
  aiRateLimit            AiRateLimit?
  proactiveScanCaches    ProactiveScanCache[]
  introSuggestionCaches  IntroSuggestionCache[]
  notes                  Note[]
  agendaItemStates       AgendaItemState[]
  linkedinImports        LinkedinImport[]
  linkedinContacts       LinkedinContact[]
  knowledgeDocs          KnowledgeDoc[]
  deletedRecords         DeletedRecord[]

  @@map("organizations")
}

/// Platform-level identity (spec §3.2). One human = one row (managed by Clerk),
/// spanning orgs via org_memberships. No org_id: identity is shared, data is not.
model User {
  id      String @id @default(uuid()) @db.Uuid
  clerkId String @unique @map("clerk_id")
  email   String @unique
  name    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships        OrgMembership[]
  ownedActionItems   ActionItem[]         @relation("ActionItemOwnerUser")
  activities         Activity[]           @relation("ActivityActor")
  ownedCompanies     Company[]            @relation("CompanyOwner")
  authoredNotes      Note[]               @relation("NoteAuthor")
  ownedIntroductions Introduction[]       @relation("IntroductionOwner")
  ownedProposals     MembershipProposal[] @relation("ProposalOwner")
  attendedMeetings   MeetingStaffAttendee[]

  @@map("users")
}

/// Junction: which users belong to which org, in what role (spec §3.3).
model OrgMembership {
  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// admin, staff
  role   String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("org_memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant-scoped tables (every one carries org_id + RLS)
// ─────────────────────────────────────────────────────────────────────────────

/// The managed relationship — the central table (spec §3.4). Relationship
/// attributes (status, tier, temperature, value) live here, not on contacts.
model Company {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  name        String
  /// prospect, member, strategic_partner, former (lifecycle, not separate tables)
  status      String
  /// e.g. strategic_partner_10k, executive_board_20k, chairmans_circle_50k
  tier        String?
  /// Relationship strength score (demo's `lk`). Company-level only in v1.
  temperature Int?
  industry    String
  /// Standardized on dollars (not thousands) — spec §2, conventions.
  annualValue Decimal @map("annual_value") @db.Decimal(14, 2)
  website     String?
  /// Company LinkedIn page URL (optional), linkable from the profile.
  linkedin    String?
  /// Drives Fireflies attendee -> company matching.
  emailDomain String? @map("email_domain")
  /// How the relationship originated (demo's `src`).
  source      String?
  notes       String  @default("")

  // ── Slice 11.0 additive expansion (all nullable / defaulted; backfilled) ──
  /// HV counties served (demo `counties`). Filter bars.
  counties       String[]  @default([])
  /// Typical deal size, free text (demo `dealSize`).
  dealSize       String?   @map("deal_size")
  /// What they need from the network — drives the intro engine (demo `lookingFor`).
  lookingFor     String?   @map("looking_for")
  /// What they bring — drives the intro engine (demo `canOffer`).
  canOffer       String?   @map("can_offer")
  /// Gov/agency relationships (demo `agencyContacts`).
  agencyContacts String?   @map("agency_contacts")
  /// Org tags: seeking_equity, ida_active, … (demo `networkTags`). Filter bars.
  networkTags    String[]  @default([]) @map("network_tags")
  /// Relationship owner. Plain FK to users.id — app-layer boundary-checked
  /// inside withOrg (users is platform-level, so no composite-FK guard applies).
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  /// Year joined (demo `memberSince`). Matches invoice installment logic.
  memberSince    Int?      @map("member_since")
  /// Newest note/meeting touch — powers the Needs-a-Call panel. App-maintained.
  lastContactAt  DateTime? @map("last_contact_at") @db.Timestamptz(6)
  /// Nested/evolving service tracking: { ida:{…}, capital:{…} }.
  services       Json      @default("{}")

  // ── S7 profile-field parity (all nullable / defaulted) ──
  /// Prospect likelihood 1–5 (demo `lk`) — pips on the row + prospects filter.
  likelihood         Int?     @db.SmallInt
  /// When true the tier is pinned manually; otherwise it's auto-assigned from
  /// annualValue against the org's configured tier thresholds on each save.
  tierLocked         Boolean  @default(false) @map("tier_locked")
  /// In-network referrer (demo `referredById`). Self-FK, SetNull, re-checked
  /// in-org at the app layer inside withOrg (plain FK bypasses RLS).
  referredById       String?  @map("referred_by_id") @db.Uuid
  /// External referrer name when the referrer isn't in the network.
  referredByExternal String?  @map("referred_by_external")
  /// Consulting / IDA engagement note (demo `cons`) — drives the list badge.
  consulting         String?

  // ── P6 partnership section (strategic_partner companies only) ──
  /// What kind of partner: Government Agency, Economic Dev, Financial Institution…
  partnerCategory     String @default("") @map("partner_category")
  /// The partner's role / how HVEDC relates to them (demo `partnerRelationship`).
  partnerRelationship String @default("") @map("partner_relationship")
  /// Who they are + why they're strategic (demo `partnerSummary`; AI-fillable).
  partnerSummary      String @default("") @map("partner_summary")
  /// What we're actively working on together (demo `collaborationNotes`).
  collaborationNotes  String @default("") @map("collaboration_notes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner                 User?                @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  contacts              Contact[]
  projectLinks          ProjectLink[]
  invoices              Invoice[]
  newsItems             NewsItem[]
  emailMessages         EmailMessage[]
  activities            Activity[]
  membershipProposals   MembershipProposal[]
  valueDelivered        ValueDelivered[]
  actionItems           ActionItem[]
  affiliations          Affiliation[]
  keyRelationships      KeyRelationship[]    @relation("KeyRelationshipOwner")
  linkedFromKeyRels     KeyRelationship[]    @relation("KeyRelationshipLink")
  projectTeamMembers    ProjectTeamMember[]
  developedProjects     Project[]            @relation("ProjectDeveloper")
  dismissalsAsFocus     IntroDismissal[]     @relation("IntroDismissalFocus")
  dismissalsAsCandidate IntroDismissal[]     @relation("IntroDismissalCandidate")
  introSuggestionCaches IntroSuggestionCache[]
  eventConversions      EventConversion[]
  venueEvents           Event[]              @relation("EventVenueCompany")
  timelineNotes         Note[]
  referredBy            Company?             @relation("CompanyReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Company[]            @relation("CompanyReferral")

  // Composite-FK target so tenant junctions (project_links) can reference
  // (id, org_id) and never point at a company in another org.
  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, emailDomain])
  @@index([orgId, referredById])
  @@map("companies")
}

/// People at companies (spec §3.5). Tenant-scoped even when the same human
/// exists in another org's tenant — sealed silos.
model Contact {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @map("org_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  name      String
  /// Primary key for meeting matching.
  email     String?
  phone     String?
  title     String?
  /// The main relationship contact at the firm.
  isPrimary Boolean @default(false) @map("is_primary")
  notes     String  @default("")

  // ── Slice 11.0 additive expansion ──
  /// Profile URL (demo `linkedin`).
  linkedin String?
  /// Contact tags: decision_maker, hnw, family_office, … (demo `tags`).
  tags     String[] @default([])
  /// Extra emails beyond the primary (demo `emails[]`) — widens Fireflies match.
  additionalEmails String[] @default([]) @map("additional_emails")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  introsAsPartyA   Introduction[]    @relation("IntroPartyA")
  introsAsPartyB   Introduction[]    @relation("IntroPartyB")
  meetingAttendees MeetingAttendee[]
  ownedActionItems ActionItem[]      @relation("ActionItemOwnerContact")
  eventInvitees    EventInvitee[]
  venueEvents      Event[]           @relation("EventVenueContact")
  /// The LinkedIn-tier row this contact was promoted from, if any.
  linkedinSource   LinkedinContact?  @relation("LinkedinPromotion")

  // Composite-FK target for meeting_attendees (id, org_id).
  @@unique([id, orgId])
  @@index([orgId])
  @@index([companyId])
  @@index([orgId, email])
  @@map("contacts")
}

/// A single LinkedIn "Connections.csv" upload — the frozen snapshot-of-record for
/// the file itself (spec: LinkedIn contact layer). Contact ROWS dedupe across
/// imports, but each upload keeps its own provenance row so the export date and
/// file are always attributable. Tenant-scoped (RLS).
model LinkedinImport {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  /// User-supplied export date (LinkedIn's CSV does not embed it). Always shown
  /// alongside results so recall never implies more freshness than exists.
  exportedOn       DateTime? @map("exported_on") @db.Timestamptz(6)
  fileName         String?   @map("file_name")
  rowCount         Int       @map("row_count")
  importedByUserId String?   @map("imported_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts     LinkedinContact[]

  @@index([orgId])
  @@map("linkedin_imports")
}

/// A person from the LinkedIn export — a SEPARATE storage tier from Contact so the
/// recall layer never clutters the member/contact lists. One row per person
/// (deduped by dedupeKey); re-imports update dimensions and keep the most recent
/// export as provenance. STATED fields are verbatim from the CSV; the INFERRED
/// dimensions are null until the enrichment pass fills them (enrichedAt null =
/// invisible to search). Every inferred dimension carries its own *Source
/// (stated|inferred) and *Confidence (high|low) so provenance is never lost.
model LinkedinContact {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  importId  String @map("import_id") @db.Uuid
  /// One-row-per-person key: normalized profileUrl, else normalized name|company.
  dedupeKey String @map("dedupe_key")

  // ── STATED (verbatim from the CSV) ──
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  fullName    String    @map("full_name")
  company     String    @default("")
  title       String    @default("")
  profileUrl  String?   @map("profile_url")
  email       String?
  connectedOn DateTime? @map("connected_on") @db.Timestamptz(6)

  // ── INFERRED dimensions (null until enriched; geography deferred to promotion) ──
  industry              String?
  industrySource        String? @map("industry_source")
  industryConfidence    String? @map("industry_confidence")
  geography             String?
  geographySource       String? @map("geography_source")
  geographyConfidence   String? @map("geography_confidence")
  seniority             String?
  senioritySource       String? @map("seniority_source")
  seniorityConfidence   String? @map("seniority_confidence")
  jobFunction           String? @map("job_function")
  jobFunctionSource     String? @map("job_function_source")
  jobFunctionConfidence String? @map("job_function_confidence")

  /// Null = not yet enriched, therefore invisible to the recall search.
  enrichedAt DateTime? @map("enriched_at") @db.Timestamptz(6)

  // ── PROMOTION path (into a real Contact) ──
  promotedContactId String?   @map("promoted_contact_id") @db.Uuid
  promotedAt        DateTime? @map("promoted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  import          LinkedinImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  // Composite FK keeps the promotion target inside the same tenant.
  promotedContact Contact?       @relation("LinkedinPromotion", fields: [promotedContactId, orgId], references: [id, orgId], onDelete: SetNull)

  @@unique([orgId, dedupeKey])
  @@unique([promotedContactId, orgId])
  @@index([orgId])
  @@index([orgId, importId])
  @@index([orgId, enrichedAt])
  @@map("linkedin_contacts")
}

/// A piece of a tenant's own collateral — a pitch deck, value-prop one-pager, or
/// SOP — stored as EXTRACTED TEXT (never a binary). Per-tenant knowledge that
/// grounds the proposal + prospect value-prop generators in each org's real
/// material. Tenant-scoped (RLS).
model KnowledgeDoc {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  /// deck | value_prop | sop | other (see @/lib/knowledge-docs).
  kind    String
  title   String
  /// Normalized text extracted from the upload (or pasted directly).
  content String @db.Text
  /// Original filename when uploaded; null when pasted.
  sourceName String? @map("source_name")
  charCount  Int     @map("char_count")
  /// The admin who added it (users carry no RLS, so a plain uuid, no FK).
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, kind])
  @@map("knowledge_docs")
}

/// Multi-party initiatives — relocations, developments, cluster efforts (spec §3.6).
model Project {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  name        String
  /// Pipeline stage — enum defined per product needs. Vocabulary (demo's board):
  /// concept, pre_development, entitlements, planning_board, capital_raise,
  /// construction_docs, under_construction, stabilization, completed, on_hold.
  stage       String
  description String    @default("")
  targetDate  DateTime? @map("target_date") @db.Date
  value       Decimal?  @db.Decimal(14, 2)

  // ── Slice 11.0 additive expansion (all nullable / defaulted; backfilled) ──
  /// Project type / phase category (demo `type`).
  type           String?
  /// Sector / industry — distinct from `type` (demo `industry`). Feeds funding-
  /// source suggestions and the profile facts.
  industry       String?
  /// Location (demo `county`).
  county         String?
  /// Units / keys — pipeline metric (demo `units`).
  units          Int?
  /// Gross square footage — pipeline metric (demo `sqft`).
  sqft           Int?
  /// Value actually realized — powers Value Created (demo `realizedValue`).
  realizedValue  Decimal? @map("realized_value") @db.Decimal(14, 2)
  /// Lead org/name if not yet a member (demo `prospectLead`).
  prospectLead   String?  @map("prospect_lead")
  /// The developer/lead as a network company, when one exists (demo `developerMemberId`).
  /// PLAIN nullable FK (SetNull); same-org enforced in the action inside withOrg,
  /// since a composite SetNull would fight org_id's NOT NULL (mirrors team members).
  developerMemberId String? @map("developer_member_id") @db.Uuid
  /// { permanentJobs, constructionJobs, constructionCost, taxAbatement, grants[] }.
  economicImpact Json     @default("{}") @map("economic_impact")
  /// { capitalSourcing, idaNavigation, realEstateSales, grantCfa }.
  hvServices     Json     @default("{}") @map("hv_services")
  /// [{ stage, date }] — stage transitions (Activity is company-scoped, not project).
  stageHistory   Json     @default("[]") @map("stage_history")
  /// What the project is asking the org to help with (@/lib/project-assistance
  /// keys) — an intake/needs signal distinct from hvServices (delivered lines).
  assistanceRequested String[] @default([]) @map("assistance_requested")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  developer      Company?            @relation("ProjectDeveloper", fields: [developerMemberId], references: [id], onDelete: SetNull)
  projectLinks   ProjectLink[]
  introductions  Introduction[]
  events         Event[]
  actionItems    ActionItem[]
  teamMembers    ProjectTeamMember[]
  fundingSources FundingSource[]
  newsItems      NewsItem[]

  // Composite-FK target for project_links (id, org_id).
  @@unique([id, orgId])
  @@index([orgId])
  @@map("projects")
}

/// Many-to-many: which companies participate in which projects, and how (spec §3.7).
/// Carries org_id (beyond the spec's literal column list) per CLAUDE.md cardinal
/// rule #1 so RLS scopes this table directly instead of via joins. Ratified.
/// The item-3 migration adds composite FKs so a link can never straddle orgs:
///   (org_id, project_id) -> projects(org_id, id)
///   (org_id, company_id) -> companies(org_id, id)
model ProjectLink {
  orgId     String @map("org_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid
  /// Team role. Base vocab: developer, lender, site_host, agency, advisor.
  /// Slice 11.0 expands to the demo's 20 disciplines (architect, civil_engineer,
  /// land_use_attorney, bridge_lender, general_contractor, interior_designer,
  /// owners_rep, environmental, landscape_architect, design_architect,
  /// structural_engineer, mep_engineer, historic_preservation, equity_partner,
  /// tax_credit_consultant, hospitality_operator, surveyor, traffic_engineer,
  /// permitting_consultant, …). Open-role detection = disciplines with no link.
  role      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FKs include org_id so a link's parents must be in the SAME org.
  project      Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  company      Company      @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)

  @@id([projectId, companyId])
  @@index([orgId])
  @@index([companyId])
  @@map("project_links")
}

/// The professional team on a project (projects-module parity; ported from the
/// prototype's Professional Team section). Unlike ProjectLink (a network company in a
/// pipeline role), a team member is an individual professional — architect,
/// attorney, lender, GC, etc. — captured as free text (name/org/email) so
/// off-network professionals can be tracked, with an OPTIONAL link to a network
/// company when one exists. `role` vocab lives in @/lib/team-roles.
model ProjectTeamMember {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  /// Discipline — see @/lib/team-roles (TEAM_ROLES).
  role      String
  name      String @default("")
  org       String @default("")
  email     String @default("")
  /// Optional link to a network company (the professional's firm). PLAIN nullable FK
  /// (SetNull); same-org is enforced in the action inside withOrg, since a
  /// composite SetNull would fight org_id's NOT NULL (mirrors key_relationships).
  companyId String? @map("company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK (project_id, org_id) -> projects(id, org_id): a team member can
  // never straddle orgs. Cascade (a member dies with the project).
  project      Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@map("project_team_members")
}

/// Funding sources & grants tracked on a project (projects-module parity; ported
/// from the prototype's Funding Sources & Grants section). Each row is a state/
/// federal/alternative capital program the project is pursuing — added manually
/// or promoted from an AI suggestion. `category` (Grant|Loan|Tax Benefit|Bond|
/// Equity) and `status` (Identified|Researching|Applied|Awarded|Declined) vocab
/// lives in @/lib/funding. `aiSuggested` marks rows that came from AI Suggest.
model FundingSource {
  id                String  @id @default(uuid()) @db.Uuid
  orgId             String  @map("org_id") @db.Uuid
  projectId         String  @map("project_id") @db.Uuid
  name              String
  agency            String  @default("")
  /// See @/lib/funding (FUNDING_CATEGORIES).
  category          String  @default("Grant")
  estimatedBenefit  String  @default("") @map("estimated_benefit")
  /// See @/lib/funding (FUNDING_STATUSES).
  status            String  @default("Identified")
  rationale         String  @default("")
  action            String  @default("")
  notes             String  @default("")
  aiSuggested       Boolean @default(false) @map("ai_suggested")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK (project_id, org_id) -> projects(id, org_id): a funding source
  // can never straddle orgs. Cascade (a source dies with the project).
  project      Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId])
  @@map("funding_sources")
}

/// First-class object — the product's core verb (spec §3.8). Generates the board report.
model Introduction {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  partyAContactId String    @map("party_a_contact_id") @db.Uuid
  partyBContactId String    @map("party_b_contact_id") @db.Uuid
  /// suggested, drafted, made, meeting_held, closed
  status          String
  /// manual, detected (Fireflies title scan), ai_suggested
  source          String
  /// Free text or enum: what came of it.
  outcome         String?
  madeOn          DateTime? @map("made_on") @db.Date
  /// If the intro advanced a specific project.
  projectId       String?   @map("project_id") @db.Uuid
  /// If the intro was made at an event. Plain FK to events.id (SetNull) — an
  /// intro is first-class and outlives the event; app-layer re-checked withOrg.
  eventId         String?   @map("event_id") @db.Uuid
  notes           String    @default("")
  /// Taxonomy label for why the pair connects (INTRO_CONNECTION_TYPES).
  connectionType  String    @default("") @map("connection_type")
  /// One-line "why" — the intro's talking-point headline.
  headline        String    @default("")
  /// The staff user who owns this intro — scopes the dashboard to "mine".
  /// Plain FK to users.id (SetNull); users is platform-level so no composite guard.
  ownerUserId     String?   @map("owner_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  partyA         Contact          @relation("IntroPartyA", fields: [partyAContactId], references: [id])
  partyB         Contact          @relation("IntroPartyB", fields: [partyBContactId], references: [id])
  project        Project?         @relation(fields: [projectId], references: [id])
  event          Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner          User?            @relation("IntroductionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  valueDelivered ValueDelivered[]

  @@index([orgId])
  @@index([partyAContactId])
  @@index([partyBContactId])
  @@index([projectId])
  @@index([eventId])
  @@map("introductions")
}

/// Synced from Fireflies, or manually created (spec §3.9).
model Meeting {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  /// Null for manual meetings; unique for sync idempotency.
  firefliesId   String?  @unique @map("fireflies_id")
  title         String
  heldAt        DateTime @map("held_at") @db.Timestamptz(6)
  summary       String?
  /// Fireflies' structured action_items text, kept separate from the narrative
  /// summary so the meeting card stays clean and extraction reads real
  /// commitments (with owners) instead of the thematic overview.
  actionItemsText String? @map("action_items_text") @db.Text
  transcriptUrl String?  @map("transcript_url")
  /// Manual-log only (item 11); Fireflies-synced meetings leave these null.
  durationMinutes Int?   @map("duration_minutes") @db.SmallInt
  location        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendees     MeetingAttendee[]
  staffAttendees MeetingStaffAttendee[]
  actionItems   ActionItem[]

  // Composite-FK target for meeting_attendees (id, org_id).
  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, heldAt(sort: Desc)])
  @@map("meetings")
}

/// Which of THIS tenant's staff attended a meeting (tier-3 personalization).
/// Fireflies transcripts carry attendee emails but never a host/organizer, and
/// the credential is org-wide — so a staff member is identified by matching the
/// attendee email against the org's own users during reconcile. Lets the
/// dashboard scope "New Connections" to the meetings a given staffer was on, and
/// stops a staffer's own email from being captured as their own new connection.
model MeetingStaffAttendee {
  orgId     String @map("org_id") @db.Uuid
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so the meeting must be in the SAME org.
  meeting      Meeting      @relation(fields: [meetingId, orgId], references: [id, orgId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("meeting_staff_attendees")
}

/// Junction with match provenance (spec §3.10). Low-confidence matches are
/// surfaced for human confirmation, never silently merged.
/// Carries org_id (beyond the spec's literal column list) per cardinal rule #1;
/// ratified. The item-3 migration adds composite FKs to prevent cross-org links:
///   (org_id, meeting_id) -> meetings(org_id, id)
///   (org_id, contact_id) -> contacts(org_id, id)
model MeetingAttendee {
  orgId       String  @map("org_id") @db.Uuid
  meetingId   String  @map("meeting_id") @db.Uuid
  contactId   String  @map("contact_id") @db.Uuid
  /// email, domain, display_name, surname, manual
  matchMethod String  @map("match_method")
  /// 0–1; surface < threshold for confirmation.
  confidence  Float
  /// Human-verified match.
  confirmed   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FKs include org_id so an attendee's meeting and contact must be
  // in the SAME org — a cross-org attendee row cannot exist.
  meeting      Meeting      @relation(fields: [meetingId, orgId], references: [id, orgId], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId, orgId], references: [id, orgId], onDelete: Cascade)

  @@id([meetingId, contactId])
  @@index([orgId])
  @@index([contactId])
  @@map("meeting_attendees")
}

/// Commitments, from meetings or manual entry (spec §3.11). Polymorphic owner:
/// exactly one of owner_user_id ("we owe") / owner_contact_id ("they owe").
/// The XOR is enforced by a CHECK constraint added via raw SQL in the migration
/// (Prisma schema cannot express CHECK constraints) — see build-order item 3.
model ActionItem {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  /// Null for manually created items.
  meetingId      String?   @map("meeting_id") @db.Uuid
  /// Null unless this item is a deliverable owed on a project.
  projectId      String?   @map("project_id") @db.Uuid
  /// Null unless this item is a manual commitment logged on a company profile.
  companyId      String?   @map("company_id") @db.Uuid
  /// Null unless this item is a follow-up logged on an event debrief.
  eventId        String?   @map("event_id") @db.Uuid
  text           String
  /// open, done, dropped
  status         String    @default("open")
  dueDate        DateTime? @map("due_date") @db.Date
  /// Optional note captured when the item is marked done — a reviewable record of
  /// how the follow-up was resolved. Cleared when the item is reopened.
  completionNote String?   @map("completion_note")
  /// Staff-owned ("we owe").
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  /// Network-owned ("they owe").
  ownerContactId String?   @map("owner_contact_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  // Composite FK (project_id, org_id) -> projects(id, org_id): a deliverable can
  // never straddle orgs. Cascade (not SetNull) because a composite SetNull would
  // fight org_id's NOT NULL; a project's deliverables die with the project.
  project      Project?     @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  // Composite FK (company_id, org_id) -> companies(id, org_id): a manual
  // commitment can never straddle orgs (mirrors project_id). Cascade — a
  // company's manual commitments die with it.
  company      Company?     @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  // Composite FK (event_id, org_id) -> events(id, org_id): a follow-up can never
  // straddle orgs (mirrors project_id/company_id). Cascade — an event's follow-up
  // items die with it.
  event        Event?       @relation(fields: [eventId, orgId], references: [id, orgId], onDelete: Cascade)
  ownerUser    User?        @relation("ActionItemOwnerUser", fields: [ownerUserId], references: [id])
  ownerContact Contact?     @relation("ActionItemOwnerContact", fields: [ownerContactId], references: [id])

  @@index([orgId])
  @@index([orgId, status, dueDate])
  @@index([orgId, projectId])
  @@index([orgId, companyId])
  @@index([orgId, eventId])
  @@map("action_items")
}

/// QuickBooks-shaped (spec §3.12). A payment schedule = multiple invoices
/// sharing a parent. "paid"/"partial" is derived from payments, never a flag.
model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  /// Org-visible number; unique per org.
  invoiceNumber   String   @map("invoice_number")
  /// Links affiliated/installment invoices.
  parentInvoiceId String?  @map("parent_invoice_id") @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  issuedOn        DateTime @map("issued_on") @db.Date
  dueOn           DateTime @map("due_on") @db.Date
  /// draft, sent, partial, paid, void — partial/paid derived from payments.
  status          String   @default("draft")
  /// Future QuickBooks sync.
  quickbooksId    String?  @map("quickbooks_id")
  notes           String   @default("")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Invoice?     @relation("InvoiceSchedule", fields: [parentInvoiceId], references: [id])
  children     Invoice[]    @relation("InvoiceSchedule")
  payments     Payment[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([companyId])
  @@index([parentInvoiceId])
  @@map("invoices")
}

/// Actual money received against an invoice (spec §3.13).
model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  receivedOn   DateTime @map("received_on") @db.Date
  /// check, ach, card, …
  method       String?
  /// Future QuickBooks sync.
  quickbooksId String?  @map("quickbooks_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([invoiceId])
  @@map("payments")
}

/// Persisted News Intelligence — localStorage in the demo (spec §3.14).
model NewsItem {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  headline   String
  url        String
  summary    String?
  // A free-text user annotation and the AI-extracted key facts (News audit item
  // 6). note is edited inline on the saved-articles list; keyFacts is populated
  // from the web-search scan and rendered as chips. Both are additive (nullable /
  // default empty) so the column add is safe against existing rows.
  note       String?
  keyFacts   String[] @default([]) @map("key_facts")
  /// Optional cross-link to a project this article is about (News audit item 5).
  /// PLAIN nullable FK (SetNull); same-org enforced in the action inside withOrg,
  /// since a composite SetNull would fight org_id's NOT NULL (mirrors developerMemberId).
  projectId  String?  @map("project_id") @db.Uuid
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([companyId])
  @@index([projectId])
  @@map("news_items")
}

/// Synced client correspondence (slice 11.12). Zapier analyses each inbound email
/// with Claude and appends a row to a published Google Sheet; a sync pulls that
/// CSV, matches each row to a company, and lands it here. companyId is nullable —
/// unmatched mail is still stored so it surfaces in an "Unmatched" bucket. Plain
/// FK (SetNull on company delete); matching runs inside withOrg so the assigned
/// company is always same-tenant. Deduped by (orgId, externalKey).
model EmailMessage {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  /// thread_id from the sheet, or a date+from_email fallback — the dedupe key.
  externalKey String   @map("external_key")
  fromName    String   @default("") @map("from_name")
  fromEmail   String   @default("") @map("from_email")
  subject     String   @default("")
  summary     String   @default("")
  /// Comma-separated project names Claude spotted.
  projects    String   @default("")
  /// Semicolon-separated follow-ups Claude spotted.
  actionItems String   @default("") @map("action_items")
  /// Indices (into the parsed actionItems list) the operator has checked off.
  doneActionItems Int[] @default([]) @map("done_action_items")
  /// positive | neutral | negative (free-text; unknown renders slate).
  sentiment   String   @default("")
  /// The email's date as reported by the sheet (free-text; stored raw).
  emailDate   String   @default("") @map("email_date")
  syncedAt    DateTime @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([orgId, externalKey])
  @@index([orgId])
  @@index([companyId])
  @@map("email_messages")
}

/// Unified timeline — everything that happens to a company lands here (spec §3.15).
model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// Null for system-generated events.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// note_added, intro_made, meeting_held, invoice_sent, status_changed, …
  type        String
  /// Type-specific detail.
  payload     Json     @default("{}")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorUserId], references: [id])

  @@index([orgId])
  @@index([companyId, occurredAt(sort: Desc)])
  @@map("activities")
}

/// Per-org OAuth tokens, encrypted at rest (spec §3.16). Encryption happens at
/// the application layer before storage — the DB only ever sees ciphertext.
model IntegrationCredential {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  /// fireflies, gmail, gcal, later quickbooks
  provider        String
  accessTokenEnc  Bytes     @map("access_token_enc")
  refreshTokenEnc Bytes?    @map("refresh_token_enc")
  scopes          String[]
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Stamped at the end of a successful sync job (see @/lib/inngest). Null until
  /// the first sync runs — drives the dashboard sync-status card's freshness.
  lastSyncedAt    DateTime? @map("last_synced_at") @db.Timestamptz(6)
  /// The message from the most recent FAILED background sync, cleared on the next
  /// success (see @/lib/inngest). Non-null means the last sync errored — surfaced
  /// on the meetings Fireflies card so background failures aren't silent.
  lastSyncError   String?   @map("last_sync_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@index([orgId])
  @@map("integration_credentials")
}

// ─────────────────────────────────────────────────────────────────────────────
// Slice 11.0 new tenant-scoped tables (full tenant treatment: org_id + RLS
// ENABLE/FORCE + tenant_isolation policy, added in the item-11.0 migration).
// ─────────────────────────────────────────────────────────────────────────────

/// Member dinners, roundtables, panels, site visits (demo `hvedc_events`).
model Event {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  name        String
  /// member_dinner, roundtable, panel, site_visit, conference, social, other
  type        String
  /// planning, invitations_sent, confirmed, completed, cancelled
  stage       String    @default("planning")
  date        DateTime? @db.Timestamptz(6)
  venue       String?
  capacity    Int?
  theme       String?
  description String    @default("")
  notes       String    @default("")
  cost        Decimal?  @db.Decimal(14, 2)
  /// Optional tie to a project (e.g. a site visit). Plain FK to projects.id
  /// (a composite FK would force SetNull to null the required org_id) —
  /// app-layer re-checked inside withOrg on write, like introductions.projectId.
  projectId   String?   @map("project_id") @db.Uuid
  /// Optional venue attribution — the member company that owns/provided the venue
  /// and/or the contact who arranged it. Tracked as a "value add" surfaced on that
  /// company's/contact's profile. Plain FKs to companies.id / contacts.id (SetNull,
  /// re-checked inside withOrg on write) — a composite FK would force SetNull to null
  /// the required org_id, same pattern as projectId.
  venueCompanyId String?  @map("venue_company_id") @db.Uuid
  venueContactId String?  @map("venue_contact_id") @db.Uuid
  /// Optional "primary guest" — the guest (an EventInvitee on this event's own list)
  /// that the event is built for / put on at the request of. Plain FK to
  /// event_invitees.id (SetNull, re-checked inside withOrg on write to confirm the
  /// invitee belongs to this event) — a composite FK would force SetNull to null the
  /// required org_id, same pattern as projectId/venueCompanyId.
  sponsorInviteeId String? @map("sponsor_invitee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  venueCompany   Company?          @relation("EventVenueCompany", fields: [venueCompanyId], references: [id], onDelete: SetNull)
  venueContact   Contact?          @relation("EventVenueContact", fields: [venueContactId], references: [id], onDelete: SetNull)
  sponsorInvitee EventInvitee?     @relation("EventSponsor", fields: [sponsorInviteeId], references: [id], onDelete: SetNull)
  invitees       EventInvitee[]    @relation("EventGuests")
  conversions    EventConversion[]
  actionItems    ActionItem[]
  introductions  Introduction[]

  // Composite-FK target for event_invitees (id, org_id).
  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, date(sort: Desc)])
  @@index([projectId])
  @@index([venueCompanyId])
  @@index([venueContactId])
  @@index([sponsorInviteeId])
  @@map("events")
}

/// Guest list for an event — a network contact or an external (non-member) guest
/// (demo eventModal guest list). Composite FKs so an invitee can't straddle orgs.
model EventInvitee {
  // Synthetic PK: contactId is nullable (external guests), so it can't be part
  // of a composite PK — and one event may have several external guests.
  id           String  @id @default(uuid()) @db.Uuid
  orgId        String  @map("org_id") @db.Uuid
  eventId      String  @map("event_id") @db.Uuid
  /// Null when the guest is external (not in the network). Plain FK to contacts.id
  /// (a composite FK would force SetNull to null the required org_id) —
  /// app-layer re-checked inside withOrg on write, like contacts.companyId.
  contactId    String? @map("contact_id") @db.Uuid
  externalName  String? @map("external_name")
  externalOrg   String? @map("external_org")
  /// External-guest contact facts (prototype extEmail/extTitle) — null for network guests.
  externalEmail String? @map("external_email")
  externalTitle String? @map("external_title")
  /// invited, confirmed, declined, attended, no_show
  rsvp          String  @default("invited")
  notes         String  @default("")
  /// Outreach tracking (demo inv.outreachStatus/outreachDraft/outreachSentAt).
  /// none → not started, draft → an invitation has been drafted, sent → emailed.
  outreachStatus String    @default("none") @map("outreach_status")
  /// The last drafted invitation body — persisted so a batch survives a reload.
  outreachDraft  String    @default("")     @map("outreach_draft")
  outreachSentAt DateTime? @map("outreach_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Event is a required parent → composite FK keeps the invitee in the event's org.
  event        Event        @relation("EventGuests", fields: [eventId, orgId], references: [id, orgId], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Events for which this invitee is the designated primary guest (SetNull on delete).
  sponsoredEvents Event[]   @relation("EventSponsor")

  @@index([orgId])
  @@index([eventId])
  @@index([contactId])
  @@map("event_invitees")
}

/// A prospect/attendee who joined as a paying member as a direct result of an event
/// (prototype draft.conversions, Coterie.html:8361). Carries the joining member's ARR
/// (dollars, like companies.annual_value) — the data source for an event's Projected
/// ROI and the network's New-members / Net-ROI metrics. Composite FK keeps it in the
/// event's org; company_id is a plain FK (SetNull, re-checked inside withOrg) since a
/// composite FK would force SetNull to null the required org_id — name is snapshotted.
model EventConversion {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  name      String
  arr       Decimal? @db.Decimal(14, 2)
  note      String   @default("")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, orgId], references: [id, orgId], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([eventId])
  @@index([companyId])
  @@map("event_conversions")
}

/// Membership proposals sent to companies (demo `hvedc_membership_proposals`).
/// Powers the dashboard "Proposals Sent" panel + revenue proposal pipeline.
model MembershipProposal {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  /// Proposed tier (Director Level, Advisory Level, …).
  tier           String
  amount         Decimal?  @db.Decimal(14, 2)
  /// draft, sent, negotiating, won, lost
  status         String    @default("draft")
  sentOn         DateTime? @map("sent_on") @db.Date
  lastFollowUpAt DateTime? @map("last_follow_up_at") @db.Timestamptz(6)
  driveUrl       String?   @map("drive_url")
  notes          String    @default("")
  /// The staff user who owns this proposal — scopes the dashboard to "mine".
  /// Plain FK to users.id (SetNull); users is platform-level so no composite guard.
  ownerUserId    String?   @map("owner_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so a proposal's company must be in the SAME org.
  company      Company      @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  owner        User?        @relation("ProposalOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([companyId])
  @@index([orgId, status])
  @@map("membership_proposals")
}

/// Per-company Value Delivered ledger (slice P4). Records a concrete win the
/// network delivered to a member — an introduction that bore fruit, a grant, a
/// service rendered — with the outcome and the derived dollar value. Powers the
/// profile's Value Delivered card (per-member drill-down of value created); the
/// org-wide rollup stays on the Value Created page. Tenant-scoped: org_id + RLS.
model ValueDelivered {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// introduction, service, grant, event, other (see @/lib/value-kinds)
  kind           String   @default("other")
  /// Optional link to the introduction that drove this value. Plain nullable FK
  /// (introductions has no composite (id, org_id) target) — app-layer re-checked
  /// inside withOrg on write, like introductions.projectId.
  introductionId String?  @map("introduction_id") @db.Uuid
  /// Derived dollar value; null when the value is non-monetary.
  amount         Decimal? @db.Decimal(14, 2)
  /// What was delivered.
  summary        String   @default("")
  /// The result / outcome.
  outcome        String   @default("")
  occurredAt     DateTime @map("occurred_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so the recipient company must be in the SAME org.
  company      Company       @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  introduction Introduction? @relation(fields: [introductionId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([companyId])
  @@index([orgId, occurredAt(sort: Desc)])
  @@map("value_delivered")
}

/// Manual relationship note (slice S8c, the prototype's timelineNotes[] on the
/// member modal, Coterie.html:6217). A free-text touchpoint a user records
/// against a company — a call, a hallway chat, a reminder — merged into the
/// relationship timeline alongside the derived facts (meetings, intros,
/// commitments). Unlike those, a note is directly authored, so it's the one
/// timeline source the profile can add / edit / delete. Tenant-scoped: org_id +
/// RLS; composite company FK so a note can only hang off an in-org member.
model Note {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// The author; null once the user is deleted (SetNull) so the note survives.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  body        String
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so a note's company must be in the SAME org.
  company      Company      @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  author       User?        @relation("NoteAuthor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([companyId])
  @@index([orgId, occurredAt(sort: Desc)])
  @@map("notes")
}

/// Additional companies / affiliations for a member (slice P5). A member often
/// wears more than one hat — a separate business line or capacity (e.g. a bank
/// contact who also runs a private fund) — each with its own offer/need profile.
/// Captures those so the network sees (and can match on) every hat a member
/// wears. A lightweight sub-record of the owning company (flat text fields,
/// mirroring the prototype's inline editor); not a company row itself. Tenant-
/// scoped: org_id + RLS, composite company FK so it can only hang off an in-org
/// member.
model Affiliation {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  /// The affiliated company / business name.
  name       String @default("")
  /// The member's role there (e.g. Managing Partner).
  role       String @default("")
  industry   String @default("")
  website    String @default("")
  canOffer   String @default("") @map("can_offer")
  lookingFor String @default("") @map("looking_for")
  /// Free-text geography (e.g. "Dutchess, Ulster, Orange"), mirroring the
  /// prototype's flat sub-record.
  counties   String @default("")
  dealSize   String @default("") @map("deal_size")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so an affiliation can only hang off an in-org member.
  company      Company      @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([orgId])
  @@index([companyId])
  @@map("affiliations")
}

/// Their Network (slice P6b) — key external contacts a strategic partner can
/// connect the network with. A flat sub-record of the owning partner company,
/// optionally linked to a network company (linkedCompanyId) once that contact's org
/// becomes a member/prospect in this tenant. Emails feed meeting matching.
model KeyRelationship {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @map("org_id") @db.Uuid
  /// The strategic-partner company that owns this relationship.
  companyId       String  @map("company_id") @db.Uuid
  name            String  @default("")
  title           String  @default("")
  org             String  @default("")
  /// Why this contact matters to the network (free text).
  relevance       String  @default("")
  email           String  @default("")
  phone           String  @default("")
  /// Optional link to a company in THIS org. Plain FK (app-layer boundary-
  /// checked inside withOrg, like Company.ownerUserId) so a SET NULL on delete
  /// doesn't fight the composite (id, org_id) target.
  linkedCompanyId String? @map("linked_company_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK includes org_id so a relationship only hangs off an in-org partner.
  company       Company      @relation("KeyRelationshipOwner", fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  linkedCompany Company?     @relation("KeyRelationshipLink", fields: [linkedCompanyId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([companyId])
  @@map("key_relationships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Slice 11.4c new tenant-scoped table (full tenant treatment: org_id + RLS
// ENABLE/FORCE + tenant_isolation policy, added in the 11.4c migration).
// ─────────────────────────────────────────────────────────────────────────────

/// Durable "don't suggest this pairing again" ledger for the introduction engine
/// (slice 11.4c; demo DISMISSED_KEY). When a user dismisses a suggested intro
/// between a FOCUS company and a CANDIDATE, we persist the directional pair plus a
/// reason so future per-member / proactive scans exclude it. Directional (focus →
/// candidate) mirrors how the per-member scan is run from one company's viewpoint;
/// the scan excludes both stored orientations to keep pairs from reappearing.
model IntroDismissal {
  id                 String @id @default(uuid()) @db.Uuid
  orgId              String @map("org_id") @db.Uuid
  focusCompanyId     String @map("focus_company_id") @db.Uuid
  candidateCompanyId String @map("candidate_company_id") @db.Uuid
  /// not_relevant, already_connected, competitor, wrong_timing (demo skip reasons)
  reason             String @default("not_relevant")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FKs include org_id so both companies must be in the SAME org — a
  // dismissal can never reference a company in another tenant.
  focus        Company      @relation("IntroDismissalFocus", fields: [focusCompanyId, orgId], references: [id, orgId], onDelete: Cascade)
  candidate    Company      @relation("IntroDismissalCandidate", fields: [candidateCompanyId, orgId], references: [id, orgId], onDelete: Cascade)

  // One dismissal per directional pair — re-dismissing is an idempotent upsert.
  @@unique([orgId, focusCompanyId, candidateCompanyId])
  @@index([orgId])
  @@index([orgId, focusCompanyId])
  @@map("intro_dismissals")
}

/// Durable "don't surface this prospect again" ledger for the Prospect Finder
/// (slice 11.6, Finder 16). External discovery surfaces NEW organisations (no network
/// row yet), so — unlike IntroDismissal — a dismissal references nothing but a name.
/// We store the normalized org name (target_key) plus a reason; the finder merges
/// these keys into excludeOrgs so parseProspectTargets drops them on the next scan.
model ProspectDismissal {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  /// Normalized (trim + lowercase) org name — the dedupe key matching parseProspectTargets.
  targetKey  String @map("target_key")
  /// The org name as displayed to the user (verbatim from the dismissed target).
  targetName String @map("target_name")
  /// not_relevant, already_connected, competitor, wrong_timing (see prospect-dismissal.ts).
  reason     String @default("not_relevant")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One dismissal per org per target name — re-dismissing is an idempotent upsert.
  @@unique([orgId, targetKey])
  @@index([orgId])
  @@map("prospect_dismissals")
}

/// Daily Focus agenda-item triage overlay (Dashboard 8). A durable done/snooze/
/// waiting mark for one focus item, identified polymorphically by (kind, refId):
/// kind is "commitment" (an actionItem) or "event", refId the underlying row's id.
/// No FK — refId points at one of two tables — so a deleted source row leaves a
/// harmless orphan that simply never matches a live item. Org-scoped (a shared
/// triage across the org's staff, matching how the focus draws every open
/// commitment/event, not one owner's); tenant-isolated by org_id + RLS.
model AgendaItemState {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  /// "commitment" (an actionItem) or "event" — see agenda-state.ts.
  kind         String
  /// The underlying actionItem.id or event.id this overlay marks.
  refId        String    @map("ref_id") @db.Uuid
  /// done, snoozed, waiting (see agenda-state.ts AGENDA_STATES).
  state        String
  /// The instant a snooze lapses (start of the next day); null unless snoozed.
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One overlay per org per focus item — re-triaging is an idempotent upsert.
  @@unique([orgId, kind, refId])
  @@index([orgId])
  @@map("agenda_item_states")
}

/// New Connections Detected — durable triage queue for Fireflies meeting attendees
/// that matched NO contact (the prototype's UNMATCHED_KEY / "New Connections
/// Detected" panel). The sync records org-affiliated strangers here instead of
/// dropping them, so a human can promote one to a prospect or attach it to an
/// existing company. Tenant-scoped: org_id + RLS. No company/contact FK — these
/// rows are pre-network and reference nothing yet.
model UnmatchedAttendee {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  /// Lowercased email — the natural de-dup key within an org.
  email            String
  /// Domain slice of the email; groups people by inferred organization.
  domain           String
  /// Best-guess person name (attendee display name, else email prefix).
  inferredName     String?   @map("inferred_name")
  /// Best-guess org name derived from the domain.
  inferredOrg      String?   @map("inferred_org")
  /// Distinct meeting ids this person appeared in — the idempotency source of
  /// truth: a re-sync only bumps seenCount when a NEW meeting id is added.
  meetingIds       String[]  @default([]) @map("meeting_ids") @db.Uuid
  /// = meetingIds.length, maintained on write so results can be ordered in SQL.
  seenCount        Int       @default(1) @map("seen_count")
  /// Title of the most recent meeting they appeared in (UI context).
  lastMeetingTitle String?   @map("last_meeting_title")
  /// Set when a human waves this person off — durable, survives re-sync.
  dismissedAt      DateTime? @map("dismissed_at") @db.Timestamptz(6)

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One row per (org, email); the sync upserts on this key.
  @@unique([orgId, email])
  @@index([orgId])
  @@index([orgId, domain])
  @@map("unmatched_attendees")
}

/// Per-org fixed-window counter that caps on-demand AI spend (audit L5+). One row
/// per tenant, keyed by org_id (no separate uuid PK — the org owns exactly one
/// budget). Two self-resetting windows: a short burst window (minute) and a daily
/// ceiling. Each permitted AI call bumps both counts; enforceAiRateLimit rolls a
/// window whose start has elapsed and refuses once either cap is hit. RLS-scoped
/// like every tenant table, so a tenant only ever reads/writes its own budget.
model AiRateLimit {
  orgId             String   @id @map("org_id") @db.Uuid
  /// Start of the current burst window; count resets when it elapses.
  minuteWindowStart DateTime @map("minute_window_start") @db.Timestamptz(6)
  minuteCount       Int      @default(0) @map("minute_count")
  /// Start of the current daily window; count resets when it elapses.
  dayWindowStart    DateTime @map("day_window_start") @db.Timestamptz(6)
  dayCount          Int      @default(0) @map("day_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_rate_limits")
}

/// Proactive-scan cache (S6c, item 13 — the prototype's PROACTIVE_INTROS_KEY /
/// saveProactiveIntros). Persists the last network intro scan per (org, scope) so
/// the Urgent Signals panel renders instantly and only re-fires the AI scan once
/// the cache goes stale (isProactiveCacheFresh, 4h TTL). Ephemeral analysis, not a
/// source of truth — pairings are stored as JSON exactly as generateProactivePairings
/// returned them, re-validated on read. Tenant-scoped: org_id + RLS. References only
/// organizations, so the org_id FK + RLS are the full isolation story.
model ProactiveScanCache {
  orgId                     String   @map("org_id") @db.Uuid
  /// members | full — matches introScopeStatuses; one cached scan per scope.
  scope                     String
  /// The scan payload: ProactivePairing[] as returned by generateProactivePairings.
  pairings                  Json     @default("[]")
  /// Whether recent meeting intelligence grounded this scan (drives the panel badge).
  meetingIntelligenceActive Boolean  @default(false) @map("meeting_intelligence_active")
  /// When the scan was produced — drives the 4h freshness check.
  generatedAt               DateTime @map("generated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, scope])
  @@map("proactive_scan_caches")
}

/// Per-company cache of the last AI intro suggestions for a company profile
/// (written by suggestIntros). Persists the last scan per focus company so the
/// profile's "Suggested introductions" card hydrates instantly on revisit instead
/// of forcing an expensive AI rescan every time — the operator only rescans on
/// demand to look for new ones. Ephemeral analysis, not a source of truth:
/// suggestions are stored as JSON exactly as generateIntroSuggestions returned them
/// and are re-filtered against IntroDismissal rows on read, so a dismissed pair never
/// resurfaces from the cache. Tenant-scoped: org_id + RLS; the composite FK to
/// companies(id, org_id) cascades the cache away when the focus company is deleted.
model IntroSuggestionCache {
  orgId                     String   @map("org_id") @db.Uuid
  focusCompanyId            String   @map("focus_company_id") @db.Uuid
  /// The scan payload: IntroSuggestion[] as returned by generateIntroSuggestions.
  suggestions               Json     @default("[]")
  /// Whether recent meeting intelligence grounded this scan.
  meetingIntelligenceActive Boolean  @default(false) @map("meeting_intelligence_active")
  /// When the scan was produced — drives the freshness label on the card.
  generatedAt               DateTime @map("generated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  focusCompany Company      @relation(fields: [focusCompanyId, orgId], references: [id, orgId], onDelete: Cascade)

  @@id([orgId, focusCompanyId])
  @@index([orgId])
  @@map("intro_suggestion_caches")
}

/// Archival trash for recoverable hard-deletes. The two permanent-delete surfaces
/// (a company and its whole entangled subgraph, or a single contact) snapshot the
/// destroyed rows here as JSON *before* the live rows are physically removed, so an
/// admin can restore the full subgraph with original ids in FK order. We snapshot +
/// hard-delete rather than hide rows in place because RLS filters nested reads: a
/// row-hiding soft-delete would make a required `company` relation resolve to null
/// and break org-wide reads. Tenant-scoped: org_id + RLS. Ephemeral by nature —
/// entries are consumed (deleted) on restore and can be pruned.
model DeletedRecord {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  /// company | contact — which delete surface produced this snapshot.
  kind     String
  /// The primary record's original id (the company/contact that was deleted).
  recordId String @map("record_id") @db.Uuid
  /// Human label for the recover list (e.g. the company or contact name).
  label    String
  /// The destroyed subgraph exactly as read before deletion; restored verbatim.
  snapshot Json   @db.JsonB

  deletedByUserId String?  @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("deleted_records")
}
